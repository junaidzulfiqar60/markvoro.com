# Copy to .env and fill in. Never commit the real .env.

# Base URL to crawl when no --url flag is passed to scripts/crawl.
CRAWL_BASE_URL=https://www.markvoro.com

# Path to a Google service-account JSON key with access to both the
# Search Console property and the GA4 property below.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Search Console property as it appears in Search Console — use the
# sc-domain: form for a domain property, or the exact URL-prefix form.
GSC_SITE_URL=sc-domain:markvoro.com

# GA4 property ID (numbers only, from Admin > Property Settings).
GA4_PROPERTY_ID=

# PageSpeed Insights API key (Google Cloud Console > APIs & Services >
# Credentials). Requests work without a key at a much lower quota.
PAGESPEED_API_KEY=

# Comma-separated URLs to run through PageSpeed Insights. Defaults to just
# the homepage if unset.
PAGESPEED_URLS=https://www.markvoro.com

# Supabase project (see db/schema.sql, config/database.md). Not used by any
# script yet — schema is designed but no project is provisioned.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
