# Separate Postgres database from the marketing site — provision a fresh one
# (Railway/Supabase/RDS all work; must support the `vector` extension).
DATABASE_URL="postgresql://user:password@host:port/support_agent?connection_limit=5"

# Session signing secret for the dashboard JWT (long random string).
AUTH_SECRET="replace-with-a-long-random-string"

PORT=4000
# Comma-separated list of origins allowed to call the API (widget host + dashboard).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- AI providers ---
# Chat model. Default provider is Anthropic; swap per-client via Client.aiConfig.provider.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Embeddings for the knowledge base / RAG (OpenAI text-embedding-3-small, 1536 dims).
# Uses OPENAI_API_KEY above. Leave unset and knowledge-base upload degrades to
# keyword-only storage (no semantic search) rather than failing.

# Encrypts per-client channel access tokens (WhatsApp/Messenger/Instagram) at rest.
# Falls back to AUTH_SECRET if unset — set a real, separate value before any real deploy.
ENCRYPTION_KEY="replace-with-another-long-random-string"

# --- WhatsApp / Messenger / Instagram (Meta Graph API) ---
# App-level secrets, shared across all tenants — from your Meta App's dashboard.
# Per-client credentials (phone_number_id, page/IG tokens) are entered per-client
# in the dashboard's Settings > Channels page and stored encrypted, not here.
META_APP_SECRET=""
META_VERIFY_TOKEN="markvoro-support-agent"
# Webhook URLs to register in the Meta App dashboard (Webhooks product), once deployed:
#   https://<your-domain>/api/v1/webhooks/whatsapp
#   https://<your-domain>/api/v1/webhooks/messenger
#   https://<your-domain>/api/v1/webhooks/instagram

# --- Seed script only — creates the first Super Admin + one demo tenant ---
SEED_SUPER_ADMIN_EMAIL="admin@markvoro.com"
SEED_SUPER_ADMIN_PASSWORD="change-me-before-seeding"
