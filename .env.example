# Database — any PostgreSQL connection string (Railway, Neon, Supabase, Vercel Postgres, local, etc.)
DATABASE_URL="postgresql://user:password@host:port/db?sslmode=require"

# Admin session signing secret — generate a long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET="replace-with-a-long-random-string"

# Email (Resend — https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="MARKVORO <notifications@yourdomain.com>"
# Mailbox that receives lead/inquiry notifications
ADMIN_EMAIL="you@yourdomain.com"

# Image uploads (Cloudinary — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seed script only — creates the first admin dashboard login (never hardcode credentials)
SEED_ADMIN_EMAIL="admin@markvoro.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
