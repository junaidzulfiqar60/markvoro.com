generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  QUALIFIED
  CONVERTED
  CLOSED
}

enum LeadSource {
  WEBSITE
  CONTACT_FORM
  WHATSAPP
  AI_AGENT
  OTHER
}

enum AgentType {
  AI_SALES_AGENT            @map("AI Sales Agent")
  AI_CUSTOMER_SUPPORT_AGENT @map("AI Customer Support Agent")
  AI_WHATSAPP_AGENT         @map("AI WhatsApp Agent")
  AI_BOOKING_AGENT          @map("AI Booking Agent")
  AI_RECEPTIONIST           @map("AI Receptionist")
  CUSTOM_AI_AGENT           @map("Custom AI Agent")
  BUSINESS_AUTOMATION       @map("Business Automation")
}

enum PreferredCommunication {
  EMAIL
  PHONE
  WHATSAPP
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum PortfolioCategory {
  WEBSITE_DEVELOPMENT @map("Website Development")
  DIGITAL_MARKETING   @map("Digital Marketing")
  BRANDING            @map("Branding")
  AI_AUTOMATION       @map("AI Automation")
  AI_AGENTS           @map("AI Agents")
}

enum ServiceCategory {
  DIGITAL_MARKETING @map("Digital Marketing")
  WEB_DEVELOPMENT   @map("Web Development")
  BRANDING          @map("Branding")
  AI_SOLUTIONS      @map("AI Solutions")
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  profileImage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ContactLead {
  id              String     @id @default(cuid())
  fullName        String
  email           String
  phone           String
  businessName    String?
  selectedService String
  message         String
  status          LeadStatus @default(NEW)
  source          LeadSource @default(CONTACT_FORM)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ServiceInquiry {
  id             String     @id @default(cuid())
  name           String
  email          String
  phone          String
  businessName   String?
  service        String
  budget         String?
  projectDetails String
  status         LeadStatus @default(NEW)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AIAgentInquiry {
  id                        String                 @id @default(cuid())
  fullName                  String
  email                     String
  phone                     String
  businessName              String?
  industry                  String
  agentType                 AgentType
  currentProcess            String?
  businessProblem           String
  estimatedMonthlyCustomers String?
  preferredCommunication    PreferredCommunication @default(EMAIL)
  message                   String?
  status                    LeadStatus             @default(NEW)
  notes                     String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id             String            @id @default(cuid())
  email          String            @unique
  status         SubscriberStatus  @default(ACTIVE)
  subscribedAt   DateTime          @default(now())
  unsubscribedAt DateTime?
}

model PortfolioProject {
  id               String            @id @default(cuid())
  title            String
  slug             String            @unique
  category         PortfolioCategory
  shortDescription String
  fullDescription  String
  clientName       String?
  projectUrl       String?
  thumbnail        String?
  images           String[]
  technologies     String[]
  featured         Boolean           @default(false)
  published        Boolean           @default(true)
  order            Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientCompany String
  clientImage   String?
  testimonial   String
  rating        Int
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id               String          @id @default(cuid())
  title            String          @unique
  slug             String          @unique
  shortDescription String
  fullDescription  String
  icon             String
  category         ServiceCategory
  features         String[]
  featured         Boolean         @default(false)
  active           Boolean         @default(true)
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  coverImage      String?
  category        String
  tags            String[]
  author          String   @default("MARKVORO Team")
  metaTitle       String?
  metaDescription String?
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([category])
}
